{
  "expo": {
    "name": "FotosIG",
    "slug": "fotosig",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fotosig.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fotosig.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "fotosig",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FotosIG usa la cámara para ayudarte a encuadrar y hacer la foto."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FotosIG usa tu ubicación aproximada para calcular la hora dorada y el tiempo."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
